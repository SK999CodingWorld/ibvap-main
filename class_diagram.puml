@startuml class_diagram
title Class Diagram - Farmer Crop Guide Mobile App

package "User Management" {
    class Farmer {
        - farmerId: String
        - name: String
        - phoneNumber: String
        - location: Location
        - preferredLanguage: Language
        - registeredCrops: List<Crop>
        + register()
        + updateProfile()
        + selectCropsOfInterest()
        + viewGuide(cropId: String): CropGuide
        + searchGuides(query: String): List<CropGuide>
        + bookmarkGuide(guideId: String)
        + getBookmarkedGuides(): List<CropGuide>
    }

    class Location {
        - state: String
        - district: String
        - village: String
        - pincode: String
        + getCoordinates(): Coordinates
    }

    enum Language {
        HINDI
        ENGLISH
        MARATHI
        TAMIL
        TELUGU
        BENGALI
        GUJARATI
        KANNADA
    }
}

package "Content Management" {
    class CropGuide {
        - guideId: String
        - crop: Crop
        - season: Season
        - growthStages: List<GrowthStage>
        - soilRequirements: SoilRequirement
        - waterRequirements: WaterRequirement
        - fertilizerSchedule: List<FertilizerApplication>
        - pestManagement: List<PestControl>
        - harvestInfo: HarvestInfo
        - language: Language
        + getStageGuide(stageName: String): GrowthStage
        + getFertilizerSchedule(): List<FertilizerApplication>
        + getPestControls(): List<PestControl>
    }

    class Crop {
        - cropId: String
        - name: String
        - scientificName: String
        - category: CropCategory
        - durationDays: Int
        - suitableSeasons: List<Season>
        + getGuides(): List<CropGuide>
    }

    enum CropCategory {
        CEREALS
        PULSES
        OILSEEDS
        VEGETABLES
        FRUITS
        SPICES
        FIBER
    }

    enum Season {
        KHARIF
        RABI
        ZAID
    }

    class GrowthStage {
        - stageId: String
        - name: String
        - description: String
        - startDay: Int
        - endDay: Int
        - keyActivities: List<String>
        - warnings: List<String>
        + getActivities(): List<String>
        + getWarnings(): List<String>
    }

    class SoilRequirement {
        - phRange: String
        - soilType: List<String>
        - organicMatter: String
        - drainage: String
        + isSuitable(soilTest: SoilTest): Boolean
    }

    class WaterRequirement {
        - irrigationMethod: IrrigationMethod
        - frequency: String
        - criticalStages: List<String>
        - waterAmountPerHectare: Double
    }

    enum IrrigationMethod {
        DRIP
        SPRINKLER
        FLOOD
        RAINFED
    }

    class FertilizerApplication {
        - applicationId: String
        - stage: String
        - fertilizerType: FertilizerType
        - dosagePerHectare: Double
        - applicationMethod: String
        - timing: String
    }

    enum FertilizerType {
        NITROGEN
        PHOSPHORUS
        POTASSIUM
        ORGANIC
        MICRONUTRIENT
        BIOFERTILIZER
    }

    class PestControl {
        - controlId: String
        - pestName: String
        - symptoms: String
        - preventiveMeasures: List<String>
        - curativeMeasures: List<String>
        - recommendedPesticides: List<Pesticide>
        - organicAlternatives: List<String>
    }

    class Pesticide {
        - pesticideId: String
        - name: String
        - dosage: String
        - applicationMethod: String
        - preHarvestInterval: Int
        - safetyPrecautions: List<String>
    }

    class HarvestInfo {
        - expectedYield: String
        - harvestIndicators: List<String>
        - harvestingMethod: String
        - postHarvestHandling: List<String>
        - storageConditions: String
    }
}

package "Offline Support" {
    class OfflineCache {
        - cacheId: String
        - farmerId: String
        - cachedGuides: Map<String, CropGuide>
        - lastSyncTimestamp: DateTime
        + cacheGuide(guide: CropGuide)
        + getCachedGuide(guideId: String): CropGuide
        + syncWithServer()
        + clearCache()
    }

    class SyncManager {
        + syncAll()
        + syncGuides(cropIds: List<String>)
        + checkForUpdates(): List<UpdateInfo>
    }

    class UpdateInfo {
        - guideId: String
        - version: Int
        - changelog: String
    }
}

package "Notification" {
    class Notification {
        - notificationId: String
        - farmerId: String
        - type: NotificationType
        - title: String
        - message: String
        - timestamp: DateTime
        - isRead: Boolean
        + markAsRead()
    }

    enum NotificationType {
        WEATHER_ALERT
        PEST_WARNING
        FERTILIZER_REMINDER
        HARVEST_TIME
        NEW_GUIDE_AVAILABLE
        SCHEME_ANNOUNCEMENT
    }
}

' Relationships
Farmer "1" -- "*" CropGuide : views
Farmer "1" -- "*" Crop : selects
Farmer "1" -- "1" Location : has
Farmer "1" -- "1" Language : prefers
Farmer "1" -- "*" Notification : receives
Farmer "1" -- "1" OfflineCache : owns

CropGuide "1" -- "1" Crop : describes
CropGuide "1" -- "1" Season : for
CropGuide "1" -- "*" GrowthStage : contains
CropGuide "1" -- "1" SoilRequirement : requires
CropGuide "1" -- "1" WaterRequirement : requires
CropGuide "1" -- "*" FertilizerApplication : schedules
CropGuide "1" -- "*" PestControl : manages
CropGuide "1" -- "1" HarvestInfo : includes
CropGuide "1" -- "1" Language : writtenIn

Crop "1" -- "*" CropGuide : has

OfflineCache "1" -- "*" CropGuide : caches
SyncManager "1" -- "1" OfflineCache : manages

@enduml