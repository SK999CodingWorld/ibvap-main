# Multi-stage production Dockerfile for IBVAP (SIH 2026 Unified Platform)
FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .
RUN npm run build

# Production Python environment
FROM python:3.11-slim
WORKDIR /app

# Install system dependencies & curl for healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libsm6 libxext6 libxrender-dev libgl1 \
    ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY backend/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir ultralytics opencv-python-headless

# Copy application code
COPY . .

# Copy compiled frontend from builder stage to static folder
COPY --from=frontend-builder /app/frontend/dist /app/backend/static

# Default environment variables
ENV PORT=8000
ENV HOST=0.0.0.0
ENV DEMO_MODE=true
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

# Run application
CMD ["python", "run.py"]